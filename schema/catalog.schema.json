{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thedude459/open-garden-data/schema/catalog.schema.json",
  "title": "Open Garden catalog release",
  "description": "The release file open-garden-catalog-<version>.json: every crop, family, source, and companion pair. Attached to each GitHub Release so apps can validate what they download. Units are metric: centimetres and degrees Celsius.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "license", "units", "families", "sources", "crops", "companions"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "license": { "const": "CC0-1.0" },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "temperature"],
      "properties": { "length": { "const": "cm" }, "temperature": { "const": "C" } }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "commonName": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "license"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["reference", "curation", "bootstrap"] },
          "license": { "type": "string" },
          "url": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "crops": { "type": "array", "items": { "$ref": "crop.schema.json" } },
    "companions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["crops", "kind", "reason", "source"],
        "properties": {
          "crops": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
          "kind": { "enum": ["helps", "hinders", "attracts-pollinators"] },
          "reason": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    }
  }
}
